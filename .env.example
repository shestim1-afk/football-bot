# === Telegram Bot ===
# Get from @BotFather: https://t.me/BotFather
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Your Telegram user/group chat ID
# Get from @userinfobot or @RawDataBot
TELEGRAM_CHAT_ID=your_chat_id_here

# === Football API (RapidAPI) ===
# Sign up at https://www.api-football.com/ and subscribe to the FREE plan
# Then go to https://rapidapi.com/api-sports/api/api-football to get your key
RAPIDAPI_KEY=your_rapidapi_key_here

# === Bot Settings ===
# How often to poll for live matches (in seconds)
POLL_INTERVAL=60
